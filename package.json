{
  "name": "the-black-file",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync:www": "node scripts/sync-www.js",
    "cap:sync": "npx cap sync",
    "electron:run": "npm run sync:www && cd electron && npm run build && npm start",
    "electron:build-win": "npm run sync:www && node scripts/build-electron.js --win",
